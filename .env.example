# App
APP_NAME=Finance Data Processing and Access Control Backend
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=finance_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=a-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_BOOTSTRAP_KEY=

# Rate limiting (fixed window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=20

# WebSocket heartbeat/presence
HEARTBEAT_INTERVAL_SECONDS=15
ONLINE_STATUS_TTL_SECONDS=45

# Cache
DASHBOARD_CACHE_TTL_SECONDS=60

# Recycle bin retention
RECYCLE_BIN_RETENTION_DAYS=30
